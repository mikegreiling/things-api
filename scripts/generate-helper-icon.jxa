#!/usr/bin/osascript -l JavaScript
// Renders the Things API Helper app icon master (1024×1024 PNG) with Cocoa.
// Original artwork drawn in code — a white `✓_` over a blue rounded square on
// the standard macOS icon grid (824pt plate, 100pt margin). The check is a
// greater-than sign tilted until it reads as a checkmark; the underscore that
// trails it keeps the pair legible as a shell prompt.
//
// Usage: osascript -l JavaScript scripts/generate-helper-icon.jxa <out.png> [size]
//
// `size` renders the same artwork at another square edge (default 1024): the
// drawing stays in 1024pt coordinates and the context is scaled, so a 160px
// render is the master, not a resample. The icns pipeline below still starts
// from the 1024 master.
//
// To refresh deputy/AppIcon.icns from a new master:
//   osascript -l JavaScript scripts/generate-helper-icon.jxa /tmp/icon.png
//   mkdir /tmp/AppIcon.iconset
//   for s in 16 32 128 256 512; do
//     sips -z $s $s        /tmp/icon.png --out /tmp/AppIcon.iconset/icon_${s}x${s}.png
//     sips -z $((s*2)) $((s*2)) /tmp/icon.png --out /tmp/AppIcon.iconset/icon_${s}x${s}@2x.png
//   done
//   iconutil -c icns /tmp/AppIcon.iconset -o deputy/AppIcon.icns
ObjC.import("Cocoa");

const SIZE = 1024;
const RAD = Math.PI / 180;

// A greater-than sign — two arms meeting at a vertex, opening `spread` degrees
// apart and pointing left — rotated clockwise by `tilt`. Past ~75° of tilt the
// vertex swings to the bottom and the glyph reads as a checkmark: the arm that
// was the upper one becomes the long upstroke, the lower one the short entry
// stroke. Returns a three-point polyline.
function tiltedGreaterThan(vx, vy, spread, tilt, longLen, shortLen) {
  const longArm = (180 - spread / 2 - tilt) * RAD;
  const shortArm = (180 + spread / 2 - tilt) * RAD;
  return [
    [vx + longLen * Math.cos(longArm), vy + longLen * Math.sin(longArm)],
    [vx, vy],
    [vx + shortLen * Math.cos(shortArm), vy + shortLen * Math.sin(shortArm)],
  ];
}

// Translate the strokes so their combined ink box is centred on (cx, cy).
function centerInk(strokes, cx, cy) {
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  for (const s of strokes) {
    const half = s.width / 2;
    for (const [x, y] of s.points) {
      x0 = Math.min(x0, x - half);
      y0 = Math.min(y0, y - half);
      x1 = Math.max(x1, x + half);
      y1 = Math.max(y1, y + half);
    }
  }
  const dx = cx - (x0 + x1) / 2;
  const dy = cy - (y0 + y1) / 2;
  for (const s of strokes) s.points = s.points.map(([x, y]) => [x + dx, y + dy]);
  return strokes;
}

function run(argv) {
  const out = argv[0];
  if (!out) throw new Error("usage: generate-helper-icon.jxa <out.png> [size]");
  const edge = argv[1] ? Number(argv[1]) : SIZE;
  if (!Number.isFinite(edge) || edge < 1) throw new Error("size must be a positive number");

  const rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
    $(), edge, edge, 8, 4, true, false, $.NSCalibratedRGBColorSpace, 0, 0,
  );
  const ctx = $.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep);
  $.NSGraphicsContext.saveGraphicsState;
  $.NSGraphicsContext.setCurrentContext(ctx);

  // Draw in 1024pt coordinates whatever the output edge is.
  if (edge !== SIZE) {
    const xf = $.NSAffineTransform.transform;
    xf.scaleBy(edge / SIZE);
    xf.concat;
  }

  // Plate: 824×824 rounded square, Big-Sur-era corner radius.
  const inset = 100;
  const plate = $.NSMakeRect(inset, inset, SIZE - 2 * inset, SIZE - 2 * inset);
  const platePath = $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius(plate, 185, 185);
  const top = $.NSColor.colorWithSRGBRedGreenBlueAlpha(0.13, 0.5, 0.92, 1.0);
  const bottom = $.NSColor.colorWithSRGBRedGreenBlueAlpha(0.07, 0.32, 0.72, 1.0);
  const grad = $.NSGradient.alloc.initWithStartingColorEndingColor(bottom, top);
  grad.drawInBezierPathAngle(platePath, 90);

  // `✓_`: the tilted greater-than, then a cursor-width underscore sharing its
  // baseline. One motif, two readings — completed to-do and shell prompt.
  const weight = 108;
  const check = tiltedGreaterThan(0, 0, 74, 79, 336, 162);
  const checkRight = Math.max(...check.map((p) => p[0]));
  const gap = 70;
  const underscore = [[checkRight + gap, 0], [checkRight + gap + 168, 0]];

  const strokes = centerInk(
    [{ points: check, width: weight }, { points: underscore, width: weight }],
    SIZE / 2,
    SIZE / 2,
  );
  $.NSColor.whiteColor.setStroke;
  for (const s of strokes) {
    const p = $.NSBezierPath.bezierPath;
    p.moveToPoint($.NSMakePoint(s.points[0][0], s.points[0][1]));
    for (let i = 1; i < s.points.length; i++) {
      p.lineToPoint($.NSMakePoint(s.points[i][0], s.points[i][1]));
    }
    p.setLineWidth(s.width);
    p.setLineCapStyle($.NSLineCapStyleRound);
    p.setLineJoinStyle($.NSLineJoinStyleRound);
    p.stroke;
  }

  ctx.flushGraphics;
  $.NSGraphicsContext.restoreGraphicsState;

  const png = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $());
  if (!png.writeToFileAtomically($(out), true)) throw new Error("could not write " + out);
  return "wrote " + out;
}
