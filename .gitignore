node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store

# Vendored binaries: manifest is committed, payloads are not
vendor/*
!vendor/manifest.json

# Lab artifacts (evidence records, screenshots, guest DB copies)
lab/artifacts/

# Staged Things .app bundles (durable golden-source binaries; not committed)
lab/apps/

# Cached guest payloads (self-contained node tarball for the SIMFID clone drive)
lab/cache/

# Bench raw runs + transcripts (accepted scorecards are committed under bench/results/)
bench/artifacts/

# Claude Code session-local state (agent worktrees live under here — must never
# be committed or scanned by tooling)
.claude/

# Build artifacts (source + build.sh are the record)
lab/guest/disruption-monitor/disruption-monitor
deputy/build/

# The signed + notarized helper bundle the release workflow stages into the
# npm tarball. Produced by CI (or by a local `npm pack` rehearsal) — never
# committed; the tarball is its only home.
deputy/prebuilt/

# Python bytecode
__pycache__/
*.pyc
lab/vncvenv/
